{
  "name": "rate-shield",
  "version": "1.0.0",
  "type": "module",
  "description": "Blazing fast, zero-dependency in-memory & Redis rate limiting and anti-abuse middleware for Node.js, Express, and Next.js.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test dist/tests/*.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "ddos-protection",
    "anti-abuse",
    "express-middleware",
    "nextjs",
    "redis",
    "in-memory",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3"
  }
}
